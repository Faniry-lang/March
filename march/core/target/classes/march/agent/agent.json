  "examples": {
    "toolCall": "{\"stepId\":1,\"reasoningSummary\":\"Call tool\",\"toolCall\":true,\"finalAnswer\":null,\"toolName\":\"getWeather\",\"toolArgs\":{\"location\":\"Paris\"}}",
    "finalAnswer": "{\"stepId\":1,\"reasoningSummary\":\"Answer\",\"toolCall\":false,\"finalAnswer\":\"Done\",\"toolName\":null,\"toolArgs\":null}"
  }
}
